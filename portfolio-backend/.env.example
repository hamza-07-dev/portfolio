# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL — Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?schema=public"

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin seed (used once by prisma/seed.js)
ADMIN_EMAIL=hamza@example.com
ADMIN_PASSWORD=change_this_before_seeding

# n8n automation
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/portfolio-contact
